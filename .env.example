# AI Problem Generator Configuration
# Copy this file to .env.local and add your actual API keys

# === DeepSeek Configuration (Optional) ===
# DeepSeek API Key for AI problem generation
# Get your API key from: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Set DeepSeek model (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Optional: Set API timeout (default: 30000ms)
# DEEPSEEK_API_TIMEOUT=30000

# Optional: Set maximum tokens for generation (default: 4000)
# DEEPSEEK_MAX_TOKENS=4000

# === OpenAI Configuration (Optional) ===
# OpenAI API Key for AI problem generation
# Get your API key from: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Set OpenAI model (default: gpt-4-turbo)
# OPENAI_MODEL=gpt-4-turbo

# === Qwen (通义千问) Configuration (Optional) ===
# Qwen API Key for AI problem generation
# Get your API key from: https://dashscope.console.aliyun.com/
# QWEN_API_KEY=your_qwen_api_key_here

# Optional: Set Qwen model (default: qwen-turbo)
# QWEN_MODEL=qwen-turbo

# === Claude Configuration (Optional) ===
# Claude API Key for AI problem generation
# Get your API key from: https://console.anthropic.com/
# CLAUDE_API_KEY=your_claude_api_key_here

# Optional: Set Claude model (default: claude-3-haiku-20240307)
# CLAUDE_MODEL=claude-3-haiku-20240307

# === Ollama Configuration (Optional) ===
# Ollama endpoint (default: http://localhost:11434)
# OLLAMA_ENDPOINT=http://localhost:11434

# Ollama model (default: llama3)
# OLLAMA_MODEL=llama3

# The system will automatically detect which AI providers are configured.
# If multiple providers are configured, the system will use them in this order of preference:
# 1. Ollama (local)
# 2. OpenAI
# 3. Claude
# 4. Qwen
# 5. DeepSeek
# You can manually select a provider in the UI if multiple are configured.
# The frontend will fetch this configuration from the server via /api/ai-providers endpoint.

# ============================================================================
# 云端功能（可选）
# ============================================================================
# 账号系统、题目市场和发布只在配置了下面这些变量的部署上可用。
# 一个变量都不配也完全没问题：算法题、工程实战和题目工坊照常工作，
# /api/cloud/* 会明确返回 503，客户端把它渲染成「离线」而不是报错。

# === 数据库（Neon Postgres）===
# 在 https://neon.tech 建一个项目，或者在 Vercel 里用 Neon 集成一键创建。
# 用带 -pooler 的连接串；HTTP 驱动不需要连接池，但 Neon 的 pooler 主机名
# 在网络上更稳。
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 建表 / 升级结构：
#   npm run db:migrate
# 部署流水线里会自动跑（见 .github/workflows/deploy-cloud.yml）。

# === 会话密钥 ===
# 用于给登录 token 和 OAuth state 签名。至少 32 个随机字符。
# 换掉它等于让所有人退出登录。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=

# === GitHub 登录（可选）===
# 在 https://github.com/settings/developers 建一个 OAuth App。
# Authorization callback URL 填：
#   https://<你的域名>/api/cloud/auth/github/callback
# 不配的话登录页不会出现 GitHub 按钮，邮箱密码登录不受影响。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# === 部署形态（可选）===
# 对外地址。预览部署和自定义域名下 OAuth 回调地址要靠它拼对。
# 不填会从请求头推断，通常也是对的。
# CLOUD_PUBLIC_ORIGIN=https://algolocal.vercel.app

# 允许的跨域来源，逗号分隔。默认 * —— 认证走 Authorization 头而不是 cookie，
# 所以放开来源不会引入 CSRF。
# CLOUD_ALLOWED_ORIGINS=*

# OAuth 回跳白名单，逗号分隔。localhost 和本部署自身永远允许（桌面端要用），
# 这里只用来额外放行别的域名。
# CLOUD_ALLOWED_REDIRECTS=https://algolocal.example.com

# 手动触发迁移接口的口令。不配的话 /api/cloud/admin/migrate 直接 404。
# MIGRATION_TOKEN=

# === 本地开发（可选）===
# 用进程内的内存仓储代替数据库，重启即丢。只为了在本地点一点云端界面，
# 在 Vercel 上会被拒绝启用。
# ALGOLOCAL_CLOUD_MEMORY=1

# 客户端指向哪个后端。桌面端和网页版都读它，不填用内置默认值。
# NEXT_PUBLIC_CLOUD_API_BASE=https://algolocal.vercel.app

# 编译期彻底关掉云端功能，构建出一个完全不联网的客户端。
# NEXT_PUBLIC_CLOUD_DISABLED=1
