{
  "name": "algolocal",
  "version": "0.18.0",
  "private": true,
  "main": "electron-main.js",
  "description": "Offline coding practice on your own machine: LeetCode-style algorithm problems plus multi-stage engineering projects reviewed on concurrency, latency and code quality. Runs JavaScript, TypeScript and Python in the browser, with optional AI from the provider you choose.",
  "author": {
    "name": "zxypro1",
    "url": "https://github.com/zxypro1"
  },
  "license": "MIT",
  "homepage": "https://github.com/zxypro1/algolocal",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxypro1/algolocal.git"
  },
  "keywords": [
    "leetcode",
    "leetcode-alternative",
    "coding-practice",
    "coding-interview",
    "interview-preparation",
    "algorithm",
    "algorithms",
    "data-structures",
    "engineering-practice",
    "system-design",
    "concurrency",
    "code-review",
    "javascript",
    "typescript",
    "python",
    "wasm",
    "webassembly",
    "pyodide",
    "monaco-editor",
    "electron",
    "offline",
    "local-first",
    "self-hosted",
    "ai-assistant",
    "open-source"
  ],
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-lab-assets.js",
    "build": "next build",
    "postbuild": "node scripts/check-bundle.js",
    "prebuild": "node scripts/copy-lab-assets.js",
    "start": "next start",
    "deploy-local": "npm run build && npm start",
    "setup": "npm install && npm run build",
    "test": "node scripts/test-runner.js",
    "test:watch": "jest --watch",
    "test:coverage": "node scripts/test-runner.js all --coverage",
    "test:api": "jest tests/api",
    "test:specific": "node scripts/test-runner.js specific",
    "test:solutions": "node scripts/test-runner.js specific solution",
    "test:data": "node scripts/test-runner.js specific data",
    "test:engineering": "jest tests/engineering",
    "test:ai": "jest tests/ai",
    "test:editor": "jest tests/editor",
    "check:app-version": "node scripts/check-app-version.js",
    "icons:generate": "node scripts/generate-icons.js",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.js && npm run check:app-version",
    "electron:build:mac": "npm run build && electron-builder --config electron-builder.config.js --mac && npm run check:app-version",
    "electron:build:win": "npm run build && electron-builder --config electron-builder.config.js --win",
    "electron:build:linux": "npm run build && electron-builder --config electron-builder.config.js --linux",
    "electron:build:all": "npm run build && electron-builder --config electron-builder.config.js --mac --win --linux && npm run check:app-version",
    "electron:pack": "npm run build && electron-builder --config electron-builder.config.js --dir && npm run check:app-version",
    "dist": "npm run electron:build",
    "dist:mac": "npm run electron:build:mac",
    "dist:win": "npm run electron:build:win",
    "dist:linux": "npm run electron:build:linux",
    "dist:all": "npm run electron:build:all",
    "clean": "rm -rf .next dist node_modules/.cache",
    "clean:all": "rm -rf .next dist node_modules",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "release:dry": "bash scripts/release.sh patch --dry-run",
    "projects:build": "node scripts/build-projects.js",
    "projects:verify": "node scripts/build-projects.js && node scripts/verify-projects.js"
  },
  "dependencies": {
    "@mantine/core": "7.6.1",
    "@mantine/hooks": "7.6.1",
    "@mantine/notifications": "7.6.1",
    "@marcbachmann/cel-js": "^8.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@tabler/icons-react": "^3.36.1",
    "@types/katex": "^0.16.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.10.2",
    "d3-sankey": "^0.12.3",
    "isomorphic-dompurify": "^2.26.0",
    "katex": "^0.16.22",
    "marked": "^16.2.0",
    "mermaid": "^11.10.1",
    "next": "13.5.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.3",
    "recharts": "^3.6.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-cuda": "^0.21.1",
    "typescript": "5.1.6",
    "web-tree-sitter": "^0.26.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "20.4.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1",
    "electron-next": "^3.1.5",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
